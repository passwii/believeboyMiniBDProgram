.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 32rpx;
  background: var(--paper);
}

.page::after {
  position: absolute;
  right: -20%;
  bottom: -16%;
  width: 120%;
  height: 54%;
  border-radius: 50% 50% 0 0;
  background: var(--paper-deep);
  content: "";
}

.orb {
  position: absolute;
  border: 1rpx solid rgba(33, 29, 24, 0.08);
  border-radius: 50%;
}

.orb-a {
  top: -420rpx;
  left: -260rpx;
  width: 760rpx;
  height: 760rpx;
}

.orb-b {
  top: -340rpx;
  left: -190rpx;
  width: 600rpx;
  height: 600rpx;
}

.brand {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark,
.loading-mark {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--ink);
  border-radius: 50%;
  font-family: "Songti SC", serif;
  font-size: 24rpx;
  font-style: italic;
  letter-spacing: -2rpx;
}

.brand-name {
  display: block;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  letter-spacing: -1rpx;
}

.brand-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.content {
  position: relative;
  z-index: 2;
  padding-top: 112rpx;
}

.eyebrow {
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.headline {
  display: block;
  margin-top: 28rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 112rpx;
  letter-spacing: -8rpx;
  line-height: 0.94;
  white-space: pre-line;
}

.accent {
  color: var(--accent);
  font-style: italic;
}

.caption {
  display: block;
  max-width: 570rpx;
  margin-top: 38rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.8;
}

.unlock {
  position: relative;
  z-index: 2;
  margin-top: 70rpx;
  padding: 46rpx 38rpx 38rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 252, 246, 0.72);
  box-shadow: 0 28rpx 80rpx rgba(44, 37, 28, 0.08);
}

.share-label {
  display: block;
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.unlock-title {
  display: block;
  margin-top: 16rpx;
  font-family: "Songti SC", serif;
  font-size: 56rpx;
  letter-spacing: -3rpx;
}

.unlock-help {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.pin-input {
  width: 100%;
  height: 112rpx;
  margin-top: 32rpx;
  border-bottom: 2rpx solid var(--ink);
  color: var(--ink);
  font-family: "Songti SC", serif;
  font-size: 56rpx;
  letter-spacing: 54rpx;
  line-height: 112rpx;
  text-align: center;
}

.pin-error {
  display: block;
  margin-top: 18rpx;
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.6;
}

.unlock-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border-radius: 0;
  background: var(--ink);
  color: var(--paper);
  font-size: 26rpx;
  font-weight: 600;
}

.unlock-button[disabled] {
  background: var(--ink);
  color: var(--paper);
  opacity: 0.35;
}

.footnote {
  display: block;
  margin-top: 22rpx;
  color: var(--muted);
  font-size: 19rpx;
  text-align: center;
}

.meta {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  gap: 26rpx;
  margin-top: 32rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.center {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: 70vh;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.loading-line {
  width: 200rpx;
  height: 2rpx;
  margin-top: 36rpx;
  overflow: hidden;
  background: var(--line);
}

.loading-line::after {
  display: block;
  width: 40%;
  height: 100%;
  background: var(--accent);
  content: "";
}

.loading-copy {
  margin-top: 24rpx;
  color: var(--muted);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.error {
  position: relative;
  z-index: 2;
  padding-top: 180rpx;
}

.error-title {
  display: block;
  max-width: 600rpx;
  margin-top: 26rpx;
  font-family: "Songti SC", serif;
  font-size: 92rpx;
  letter-spacing: -5rpx;
  line-height: 1;
}

.error-copy {
  display: block;
  max-width: 580rpx;
  margin-top: 32rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.8;
}
