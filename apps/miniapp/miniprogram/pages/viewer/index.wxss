.missing {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: var(--paper);
}

.missing-title {
  font-family: "Songti SC", serif;
  font-size: 58rpx;
}

.missing-copy {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 26rpx;
}
